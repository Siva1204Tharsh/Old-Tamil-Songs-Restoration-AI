# ─── Application ──────────────────────────────────────
APP_NAME="Old Tamil Songs Restoration AI"
DEBUG=false

# ─── Server ───────────────────────────────────────────
HOST=127.0.0.1
PORT=8000

# ─── Storage ──────────────────────────────────────────
# Leave empty to use defaults (relative to project root)
# STORAGE_DIR=./storage
# UPLOADS_DIR=./storage/uploads
# PROCESSED_DIR=./storage/processed
# TEMP_DIR=./storage/temporary

# ─── File limits ──────────────────────────────────────
MAX_FILE_SIZE_MB=200
MAX_DURATION_SECONDS=1800

# ─── Job management ───────────────────────────────────
MAX_CONCURRENT_JOBS=2
JOB_RETENTION_HOURS=24

# ─── Audio processing ─────────────────────────────────
DEFAULT_TARGET_LUFS=-16.0
DEFAULT_TRUE_PEAK_DBTP=-1.0

# ─── Logging ──────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/restoration.log
